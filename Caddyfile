# Sert « Graine de Parole » : fichiers statiques + API PHP (FrankenPHP).
# Railway fournit le port au runtime via $PORT ; en local, repli sur 8080.

{
	frankenphp
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /app/public
	encode gzip zstd

	# ---- En-têtes de sécurité (toutes les réponses) ----
	# - nosniff : le navigateur ne « devine » jamais un type de fichier ;
	# - frame-ancestors 'none' + X-Frame-Options : personne ne peut mettre le
	#   site dans une iframe (anti-clickjacking) ;
	# - CSP : seul notre propre code s'exécute — plus les domaines Google
	#   nécessaires au bouton « Continuer avec Google » (script, style, iframe).
	#   'unsafe-inline' est requis par nos scripts anti-flash et les styles
	#   inline de l'interface ; tout le reste est verrouillé sur 'self'.
	# - HSTS : une fois venu en HTTPS, le navigateur n'essaie plus jamais HTTP.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://accounts.google.com; frame-src https://accounts.google.com; connect-src 'self' https://accounts.google.com; img-src 'self' data: https://accounts.google.com; manifest-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
	}

	# Toute l'API passe par un point d'entrée unique : api/index.php.
	# (aucun autre fichier .php n'est jamais servi ni exécuté directement ;
	# cela protège aussi api/data/ et la base SQLite de secours)
	@api path /api /api/*
	rewrite @api /api/index.php
	header @api Cache-Control "no-store"

	# Les pages d'entrée sont TOUJOURS nos index.html : sans ces réécritures,
	# php_server préfère un index.php (l'image FrankenPHP en livre un de
	# démonstration, et son try_files retombe sur celui de la racine pour les
	# dossiers qui n'en ont pas) et nos pages peuvent être détournées.
	rewrite / /index.html
	# /lire, /defi, /admin SANS barre finale : REDIRECTION (pas réécriture) vers
	# la version avec barre. Réécrire servirait la page avec une mauvaise base :
	# ses fichiers relatifs (admin.js, lire.css…) seraient cherchés à la racine
	# → 404 silencieux et page vide. La barre finale rend les chemins justes.
	redir /lire /lire/ permanent
	redir /defi /defi/ permanent
	redir /admin /admin/ permanent
	redir /frise /frise/ permanent
	redir /quiadit /quiadit/ permanent
	redir /ecritoupas /ecritoupas/ permanent
	redir /portrait /portrait/ permanent
	@lire path /lire/
	rewrite @lire /lire/index.html
	@defi path /defi/
	rewrite @defi /defi/index.html
	@admin path /admin/
	rewrite @admin /admin/index.html
	@frise path /frise/
	rewrite @frise /frise/index.html
	@quiadit path /quiadit/
	rewrite @quiadit /quiadit/index.html
	@ecritoupas path /ecritoupas/
	rewrite @ecritoupas /ecritoupas/index.html
	@portrait path /portrait/
	rewrite @portrait /portrait/index.html
	# Pages d'accueil thématiques (référencement) : mêmes règles que les modules.
	redir /quiz-biblique /quiz-biblique/ permanent
	redir /plan-lecture-bible /plan-lecture-bible/ permanent
	redir /memoriser-versets /memoriser-versets/ permanent
	redir /eglises /eglises/ permanent
	@pquiz path /quiz-biblique/
	rewrite @pquiz /quiz-biblique/index.html
	@pplan path /plan-lecture-bible/
	rewrite @pplan /plan-lecture-bible/index.html
	@pmemo path /memoriser-versets/
	rewrite @pmemo /memoriser-versets/index.html
	@peglises path /eglises/
	rewrite @peglises /eglises/index.html

	# Le service worker ne doit jamais être mis en cache,
	# sinon les mises à jour de l'appli ne parviennent pas aux utilisateurs.
	@sw path /sw.js
	header @sw Cache-Control "no-cache"

	# Les pages HTML non plus : sans en-tête, les navigateurs les gardent en
	# cache « heuristique » et une ancienne page d'accueil peut coller
	# longtemps après un déploiement. no-cache = revalider à chaque visite.
	@html path / /index.html /lire /lire/ /lire/index.html /defi /defi/ /defi/index.html /admin /admin/ /admin/index.html /frise /frise/ /frise/index.html /quiadit /quiadit/ /quiadit/index.html /ecritoupas /ecritoupas/ /ecritoupas/index.html /portrait /portrait/ /portrait/index.html /quiz-biblique/ /quiz-biblique/index.html /plan-lecture-bible/ /plan-lecture-bible/index.html /memoriser-versets/ /memoriser-versets/index.html /eglises/ /eglises/index.html /frise-essai.html
	header @html Cache-Control "no-cache"

	# Type MIME correct pour le manifeste PWA.
	@manifest path *.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# Fichiers statiques : TOUJOURS revalider (no-cache ≠ pas de cache : le
	# navigateur garde le fichier mais demande « a-t-il changé ? » à chaque
	# visite — réponse 304 quasi gratuite). L'ancien max-age=3600 faisait
	# coller les vieux JS/CSS jusqu'à une heure après chaque déploiement,
	# et écrasait même le no-cache de sw.js (les deux règles matchent *.js
	# et la dernière écrite gagne). Le hors-ligne, lui, reste assuré par le
	# service worker, pas par ce cache HTTP.
	@assets path *.css *.js *.svg *.json
	header @assets Cache-Control "no-cache"

	# Les icônes PNG (installation, notifications) ne bougent pratiquement
	# jamais : une semaine de cache — en cas de refonte, on renommera.
	@icones path /icon-*.png
	header @icones Cache-Control "public, max-age=604800"

	# Exception : la Bible ne change pas. Les 66 livres de /lire/data/ peuvent
	# vivre une journée en cache navigateur (et servir la copie périmée pendant
	# qu'une revalidation se fait en arrière-plan) sans risque d'écran mélangé —
	# 66 revalidations économisées à chaque réinstallation du service worker.
	# (Placée APRÈS la règle générale : la dernière écrite gagne.)
	@bible path /lire/data/*.json
	header @bible Cache-Control "public, max-age=86400, stale-while-revalidate=604800"

	# Sert les fichiers statiques et exécute les .php (ici : api/index.php seul).
	php_server
}
